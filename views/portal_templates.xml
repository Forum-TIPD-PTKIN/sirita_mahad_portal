<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- 1. INHERIT /my DASHBOARD & ADD CARDS -->
        <template id="portal_my_home_mahasantri" name="Portal Mahasantri Home" inherit_id="portal.portal_my_home" priority="20">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="after">
                <div class="row mt-4">
                    <div class="col-12">
                        <h4 class="fw-bold mb-3 text-dark">
                            <i class="fa fa-graduation-cap text-teal me-2"/> Layanan Mahasantri Ma'had
                        </h4>
                    </div>
                </div>
                <div class="row g-3 mb-4">
                    <!-- E-Perizinan Card -->
                    <div class="col-12 col-md-6 col-lg-3">
                        <a href="/my/permits" class="card shadow-sm border-0 h-100 text-decoration-none text-reset hover-elevate p-3">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3 text-primary">
                                    <i class="fa fa-id-card fa-2x"/>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1">E-Perizinan</h6>
                                    <small class="text-muted">Izin Pesiar &amp; Bermalam</small>
                                </div>
                            </div>
                        </a>
                    </div>

                    <!-- Buku Kendali (Ta'lim & Hafalan) Card -->
                    <div class="col-12 col-md-6 col-lg-3">
                        <a href="/my/talim" class="card shadow-sm border-0 h-100 text-decoration-none text-reset hover-elevate p-3">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3 text-success">
                                    <i class="fa fa-book fa-2x"/>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1">Buku Kendali</h6>
                                    <small class="text-muted">Ta'lim &amp; Hafalan Al-Qur'an</small>
                                </div>
                            </div>
                        </a>
                    </div>

                    <!-- Poin Disiplin Card -->
                    <div class="col-12 col-md-6 col-lg-3">
                        <a href="/my/penalties" class="card shadow-sm border-0 h-100 text-decoration-none text-reset hover-elevate p-3">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3 text-warning">
                                    <i class="fa fa-shield fa-2x"/>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1">Catatan Disiplin</h6>
                                    <small class="text-muted">Poin &amp; Sanksi Edukatif</small>
                                </div>
                            </div>
                        </a>
                    </div>

                    <!-- Syahadah & Sertifikat Card -->
                    <div class="col-12 col-md-6 col-lg-3">
                        <a href="/my/syahadah" class="card shadow-sm border-0 h-100 text-decoration-none text-reset hover-elevate p-3">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3 text-info">
                                    <i class="fa fa-certificate fa-2x"/>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1">Syahadah Digital</h6>
                                    <small class="text-muted">Verifikasi &amp; Kelulusan</small>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </xpath>
        </template>

        <!-- 2. PAGE TEMPLATES FOR EACH PORTAL FEATURE -->

        <!-- E-Perizinan Page -->
        <template id="portal_my_permits" name="Riwayat E-Perizinan">
            <t t-call="portal.portal_layout">
                <div class="container py-3">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3 class="fw-bold mb-0"><i class="fa fa-id-card text-primary me-2"/> Riwayat E-Perizinan</h3>
                        <a href="/my/permits/new" class="btn btn-primary rounded-pill px-4 shadow-sm">
                            <i class="fa fa-plus-circle me-1"/> Buat Pengajuan Izin Baru
                        </a>
                    </div>

                    <t t-if="success_msg">
                        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
                            <i class="fa fa-check-circle me-2"/><t t-esc="success_msg"/>
                        </div>
                    </t>
                    <t t-if="error_msg">
                        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
                            <i class="fa fa-exclamation-triangle me-2"/><t t-esc="error_msg"/>
                        </div>
                    </t>

                    <t t-if="not permits">
                        <div class="alert alert-info shadow-sm rounded-3 p-4 text-center">
                            <i class="fa fa-info-circle fa-2x mb-2 text-info d-block"/>
                            <h5>Belum ada pengajuan perizinan.</h5>
                            <p class="text-muted mb-3">Klik tombol di atas untuk mengajukan izin pesiar atau bermalam.</p>
                            <a href="/my/permits/new" class="btn btn-sm btn-outline-primary rounded-pill px-3">Ajukan Sekarang</a>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="table-responsive bg-white rounded-3 shadow-sm p-3">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Kode Izin</th>
                                        <th>Jenis Perizinan</th>
                                        <th>Tujuan / Alamat</th>
                                        <th>Rencana Keberangkatan</th>
                                        <th>Rencana Kembali</th>
                                        <th>Status Approval</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="permits" t-as="p">
                                        <tr>
                                            <td class="fw-bold" t-esc="p.name"/>
                                            <td>
                                                <span t-if="p.permit_type == 'pesiar'" class="badge bg-info bg-opacity-10 text-info px-2 py-1">Izin Pesiar</span>
                                                <span t-else="" class="badge bg-purple bg-opacity-10 text-purple px-2 py-1">Izin Bermalam</span>
                                            </td>
                                            <td t-esc="p.destination"/>
                                            <td t-esc="p.departure_time"/>
                                            <td t-esc="p.expected_return_time"/>
                                            <td>
                                                <span t-if="p.state == 'draft'" class="badge rounded-pill bg-warning text-dark">Draft / Menunggu Musyrif</span>
                                                <span t-elif="p.state == 'musyrif_approved'" class="badge rounded-pill bg-info">Disetujui Musyrif</span>
                                                <span t-elif="p.state == 'mudhir_approved'" class="badge rounded-pill bg-success">Disetujui Mudhir</span>
                                                <span t-elif="p.state == 'checked_out'" class="badge rounded-pill bg-primary">Di Luar Kompleks</span>
                                                <span t-elif="p.state == 'checked_in'" class="badge rounded-pill bg-secondary">Selesai (Kembali)</span>
                                                <span t-else="" class="badge rounded-pill bg-danger">Ditolak</span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </div>
            </t>
        </template>

        <!-- Form Pengajuan Izin Baru -->
        <template id="portal_my_permits_new" name="Form Pengajuan Perizinan">
            <t t-call="portal.portal_layout">
                <div class="container py-3">
                    <div class="row justify-content-center">
                        <div class="col-12 col-md-8">
                            <div class="card shadow-sm border-0 rounded-3 p-4">
                                <div class="d-flex align-items-center mb-4">
                                    <a href="/my/permits" class="btn btn-light rounded-circle me-3"><i class="fa fa-arrow-left"/></a>
                                    <h4 class="fw-bold mb-0"><i class="fa fa-paper-plane text-primary me-2"/> Form Pengajuan Izin Mandiri</h4>
                                </div>

                                <t t-if="error_msg">
                                    <div class="alert alert-danger rounded-3" role="alert">
                                        <i class="fa fa-exclamation-circle me-2"/><t t-esc="error_msg"/>
                                    </div>
                                </t>

                                <form action="/my/permits/submit" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Jenis Perizinan <span class="text-danger">*</span></label>
                                        <select name="permit_type" class="form-select" required="required">
                                            <option value="pesiar">Izin Pesiar (Siang / Sore - Tidak Bermalam)</option>
                                            <option value="bermalam">Izin Bermalam / Pulang Kampung</option>
                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Tujuan / Alamat Lengkap <span class="text-danger">*</span></label>
                                        <input type="text" name="destination" class="form-control" placeholder="Contoh: Jl. Poros Pinrang, Kota Parepare / Rumah Orang Tua" required="required"/>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold">Rencana Waktu Keluar <span class="text-danger">*</span></label>
                                            <input type="datetime-local" name="departure_time" class="form-control" required="required"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold">Rencana Waktu Kembali <span class="text-danger">*</span></label>
                                            <input type="datetime-local" name="expected_return_time" class="form-control" required="required"/>
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label fw-bold">Alasan Keperluan Izin <span class="text-danger">*</span></label>
                                        <textarea name="reason" class="form-control" rows="3" placeholder="Sebutkan keperluan mendesak izin pesiar/bermalam..." required="required"></textarea>
                                    </div>

                                    <div class="d-grid gap-2">
                                        <button type="submit" class="btn btn-primary rounded-pill py-2 fw-bold shadow-sm">
                                            <i class="fa fa-send me-1"/> Kirim Pengajuan Izin
                                        </button>
                                        <a href="/my/permits" class="btn btn-light rounded-pill py-2">Batal</a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Buku Kendali Page -->
        <template id="portal_my_talim" name="Buku Kendali Ta'lim &amp; Hafalan">
            <t t-call="portal.portal_layout">
                <div class="container py-3">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3 class="fw-bold mb-0"><i class="fa fa-book text-success me-2"/> Buku Kendali Ta'lim &amp; Hafalan</h3>
                        <button type="button" class="btn btn-success rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalJanjiSetoran">
                            <i class="fa fa-plus-circle me-1"/> Ajukan Janji Setoran
                        </button>
                    </div>

                    <t t-if="success_msg">
                        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
                            <i class="fa fa-check-circle me-2"/><t t-esc="success_msg"/>
                        </div>
                    </t>
                    <t t-if="error_msg">
                        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
                            <i class="fa fa-exclamation-triangle me-2"/><t t-esc="error_msg"/>
                        </div>
                    </t>

                    <!-- Summary Cards -->
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-4">
                            <div class="card shadow-sm border-0 rounded-3 p-3 bg-success bg-opacity-10 text-success">
                                <h6 class="fw-bold mb-1"><i class="fa fa-check-square-o me-2"/>Setoran Ziyadah</h6>
                                <h3 class="fw-bold mb-0"><t t-esc="ziyadah_count"/> Record</h3>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="card shadow-sm border-0 rounded-3 p-3 bg-primary bg-opacity-10 text-primary">
                                <h6 class="fw-bold mb-1"><i class="fa fa-star me-2"/>Predikat Mumtaz</h6>
                                <h3 class="fw-bold mb-0"><t t-esc="mumtaz_count"/> Setoran</h3>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="card shadow-sm border-0 rounded-3 p-3 bg-info bg-opacity-10 text-info">
                                <h6 class="fw-bold mb-1"><i class="fa fa-users me-2"/>Halaqah / Kelas</h6>
                                <h3 class="fw-bold mb-0"><t t-esc="len(classes)"/> Halaqah</h3>
                            </div>
                        </div>
                    </div>

                    <t t-if="not talim_records">
                        <div class="alert alert-info shadow-sm rounded-3 p-4 text-center">
                            <i class="fa fa-info-circle fa-2x mb-2 text-info d-block"/>
                            <h5>Belum ada riwayat setoran hafalan / mutaba'ah.</h5>
                            <p class="text-muted mb-0">Riwayat setoran dan nilai dari musyrif akan muncul di sini.</p>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="table-responsive bg-white rounded-3 shadow-sm p-3">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Tanggal</th>
                                        <th>Halaqah / Kelas</th>
                                        <th>Kategori</th>
                                        <th>Surah / Juz / Topik</th>
                                        <th>Predikat Status</th>
                                        <th>Catatan Musyrif</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="talim_records" t-as="t">
                                        <tr>
                                            <td t-esc="t.date"/>
                                            <td class="fw-bold" t-esc="t.class_id.name"/>
                                            <td>
                                                <span t-if="t.category == 'ziyadah'" class="badge bg-success">Ziyadah</span>
                                                <span t-elif="t.category == 'murajaah'" class="badge bg-primary">Muraja'ah</span>
                                                <span t-else="" class="badge bg-secondary" t-esc="t.category"/>
                                            </td>
                                            <td t-esc="t.surah_juz_topic"/>
                                            <td>
                                                <span t-if="t.grade_status == 'mumtaz'" class="badge rounded-pill bg-success">Mumtaz</span>
                                                <span t-elif="t.grade_status == 'jayyid_jiddan'" class="badge rounded-pill bg-info">Jayyid Jiddan</span>
                                                <span t-elif="t.grade_status == 'jayyid'" class="badge rounded-pill bg-warning text-dark">Jayyid</span>
                                                <span t-else="" class="badge rounded-pill bg-danger">Rasib</span>
                                            </td>
                                            <td t-esc="t.notes or '-'"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </div>

                <!-- Modal Janji Setoran Hafalan -->
                <div class="modal fade" id="modalJanjiSetoran" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content border-0 shadow">
                            <div class="modal-header bg-success text-white">
                                <h5 class="modal-title fw-bold"><i class="fa fa-book me-2"/> Form Janji Setoran Hafalan</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"/>
                            </div>
                            <form action="/my/talim/submit" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Pilih Halaqah / Kelas <span class="text-danger">*</span></label>
                                        <select name="class_id" class="form-select" required="required">
                                            <t t-foreach="classes" t-as="c">
                                                <option t-att-value="c.id" t-esc="c.name"/>
                                            </t>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Kategori Setoran <span class="text-danger">*</span></label>
                                        <select name="category" class="form-select" required="required">
                                            <option value="ziyadah">Ziyadah (Setoran Baru)</option>
                                            <option value="murajaah">Muraja'ah (Pengulangan Hafalan)</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Target Surah / Juz / Ayat <span class="text-danger">*</span></label>
                                        <input type="text" name="surah_juz_topic" class="form-control" placeholder="Contoh: Q.S. An-Naba' 1-30 / Juz 30" required="required"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Catatan Tambahan untuk Musyrif</label>
                                        <textarea name="notes" class="form-control" rows="2" placeholder="Catatan jam/waktu bimbingan yang diinginkan..."></textarea>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                                    <button type="submit" class="btn btn-success fw-bold px-4">Kirim Janji Setoran</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Catatan Disiplin Page -->
        <template id="portal_my_penalties" name="Catatan Disiplin">
            <t t-call="portal.portal_layout">
                <div class="container py-3">
                    <h3 class="fw-bold mb-4"><i class="fa fa-shield text-warning me-2"/> Catatan Kedisiplinan Mahasantri</h3>
                    <t t-if="not penalties">
                        <div class="alert alert-success shadow-sm rounded-3">
                            <i class="fa fa-check-circle me-2"/> Alhamdulillah! Anda tidak memiliki catatan pelanggaran kedisiplinan.
                        </div>
                    </t>
                    <t t-else="">
                        <div class="table-responsive bg-white rounded-3 shadow-sm p-3">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Tanggal</th>
                                        <th>Jenis Pelanggaran</th>
                                        <th>Poin Pelanggaran</th>
                                        <th>Sanksi Edukatif</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="penalties" t-as="pen">
                                        <tr>
                                            <td t-esc="pen.date"/>
                                            <td class="fw-bold" t-esc="pen.name"/>
                                            <td><span class="badge bg-danger" t-esc="pen.point"/> Poin</td>
                                            <td t-esc="pen.punishment or '-'"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </div>
            </t>
        </template>

        <!-- Syahadah Page -->
        <template id="portal_my_syahadah" name="Syahadah Digital">
            <t t-call="portal.portal_layout">
                <div class="container py-3">
                    <h3 class="fw-bold mb-4"><i class="fa fa-certificate text-info me-2"/> Syahadah &amp; Kelulusan Digital</h3>
                    <t t-if="not syahadah_records">
                        <div class="alert alert-info shadow-sm rounded-3">
                            <i class="fa fa-info-circle me-2"/> Syahadah digital belum diterbitkan. Pastikan seluruh kelengkapan hafalan &amp; administrasi telah terpenuhi.
                        </div>
                    </t>
                    <t t-else="">
                        <div class="row g-3">
                            <t t-foreach="syahadah_records" t-as="s">
                                <div class="col-12 col-md-6">
                                    <div class="card shadow-sm border-0 rounded-3 p-4">
                                        <div class="d-flex align-items-center mb-3">
                                            <i class="fa fa-award fa-3x text-warning me-3"/>
                                            <div>
                                                <h5 class="fw-bold mb-0" t-esc="s.name"/>
                                                <small class="text-muted">Nomor Seri: <t t-esc="s.serial_number"/></small>
                                            </div>
                                        </div>
                                        <p class="text-muted">Predikat Kelulusan: <strong class="text-dark" t-esc="s.grade"/></p>
                                        <div class="d-grid mt-3">
                                            <a t-attf-href="/syahadah/print/#{s.id}" class="btn btn-outline-primary rounded-pill">
                                                <i class="fa fa-download me-1"/> Unduh Sertifikat PDF
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
            </t>
        </template>

    </data>
</odoo>
